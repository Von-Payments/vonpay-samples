VON_PAY_SECRET_KEY=vp_sk_test_YOUR_KEY_HERE

# Per-endpoint webhook signing secret (whsec_...), shown once when you create the webhook endpoint. NOT your API key.
VON_PAY_WEBHOOK_SECRET=whsec_your_endpoint_signing_secret
BASE_URL=http://localhost:5000
PORT=5000

# Optional. The Von Payments API host (BASE_URL above is THIS app's address).
# The SDK targets production by default; a vp_sk_test_* key runs in sandbox
# mode there. Override only if support directs you elsewhere.
# VON_PAY_BASE_URL=https://checkout.vonpay.com
