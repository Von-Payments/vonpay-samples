# Secret API key: server-only, never in the page.
# Sandbox keys start with vp_sk_test_; live keys start with vp_sk_live_.
VONPAY_SECRET_KEY=

# Publishable key for the SAME account (vp_pk_test_...). The page uses it; it is public by design.
VONPAY_PUBLISHABLE_KEY=

# Optional. Unset = https://checkout.vonpay.com (a vp_sk_test_ key runs in sandbox mode there).
# VONPAY_API_BASE=https://checkout.vonpay.com

# Where the bank's 3-D Secure page sends the shopper back. localhost works on test keys only;
# a hosted funnel uses an https:// address of its own page.
# VONPAY_RETURN_URL=http://localhost:4242/?vonpay_return=1

# Optional: what the saved card is for later, declared to the card networks.
# One of: recurring | installment | unscheduled. Leave empty when your offer has no later charges.
# Use the same word you will send as mit.reason on the later charge.
# STORED_CREDENTIAL_USE=

# PORT=4242
