VON_PAY_SECRET_KEY=vp_sk_test_your_secret_key_here

# Per-endpoint webhook signing secret (whsec_...), shown once when you create the webhook endpoint. NOT your API key.
VON_PAY_WEBHOOK_SECRET=whsec_your_endpoint_signing_secret
PORT=3000

# Optional. The SDK targets production by default; a vp_sk_test_* key runs in
# sandbox mode there. Override only if support directs you elsewhere.
# VON_PAY_BASE_URL=https://checkout.vonpay.com
